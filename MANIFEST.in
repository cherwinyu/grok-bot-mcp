include LICENSE
include .gitattributes
include .gitignore
include README.md
include README.zh-CN.md
include NOTICE.md
include SECURITY.md
include CONTRIBUTING.md
include CHANGELOG.md
include RELEASE_NOTES.md
include pyproject.toml
include AGENTS.md
include ROADMAP.md
include CODE_OF_CONDUCT.md
recursive-include src *.py
recursive-include src *.md
recursive-include tests *.py
recursive-include docs *.md
recursive-include routines *.md
recursive-include examples *
recursive-include scripts *.py
recursive-include scripts *.ps1
recursive-include .github *.yml
recursive-include .github *.yaml
recursive-include .github *.md
global-exclude *.pyc
global-exclude __pycache__/*
prune docs/reports
prune docs/p0
prune tests/fixtures
exclude scripts/replay_regressions.py
exclude scripts/replay_onboarding_review.py
exclude scripts/verify_test_preservation.py
prune OpenSource
prune _private_release_audit
global-exclude private-markers.json
